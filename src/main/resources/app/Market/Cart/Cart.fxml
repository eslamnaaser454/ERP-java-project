<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="565.0" prefWidth="1267.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Market.Cart.CartController">
    <left>
        <fx:include source="../../Layouts/side-bar-view.fxml" />
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                <VBox fx:id="cartContainer" spacing="10" />
            </ScrollPane>

            <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #ffffff;">
                <Label fx:id="totalLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Total: $0.00" />
                <Button fx:id="checkoutButton" onAction="#handleCheckout"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16;"
                        text="Proceed to Checkout" />
            </VBox>
        </VBox>
    </center>
</BorderPane>