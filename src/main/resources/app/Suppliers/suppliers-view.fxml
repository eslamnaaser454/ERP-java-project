<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.ObservableList?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<?import javafx.collections.FXCollections?>
<BorderPane maxHeight="-Infinity" maxWidth="1.7976931348623157E308"
            minHeight="-Infinity" prefHeight="579.0" prefWidth="1058.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.Suppliers.SuppliersController">

   <left>
      <fx:include source="../Layouts/side-bar-view.fxml" />
   </left>

   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" focusTraversable="false"
                  hbarPolicy="NEVER" pannable="true" vbarPolicy="ALWAYS" BorderPane.alignment="CENTER">
         <content>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <VBox prefWidth="100.0" style="-fx-background-color: white;" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
                     <children>

                        <!-- 🔁 Top Search + Controls Section -->
                        <AnchorPane prefHeight="76.0" prefWidth="761.0">
                           <children>
                              <!-- ✅ Corrected ComboBox -->
                              <ComboBox fx:id="strategySelector" prefWidth="120.0" layoutX="10.0" layoutY="25.0">
                                 <items>
                                    <FXCollections fx:factory="observableArrayList">
                                       <String fx:value="Name" />
                                       <String fx:value="Company" />
                                       <String fx:value="Email" />
                                    </FXCollections>
                                 </items>
                              </ComboBox>


                              <TextField fx:id="searchField" layoutX="144.0" layoutY="26.0" promptText="Search..." style="-fx-background-color: none; -fx-border-color: rgb(232, 232, 232);" />

                              <Button onAction="#search" layoutX="324.0" layoutY="25.0" mnemonicParsing="false"
                                      prefHeight="29.0" prefWidth="93.0" style="-fx-background-color: blue;" text="search" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Button>

                              <Button onAction="#reFresh" layoutX="457.0" layoutY="25.0" mnemonicParsing="false"
                                      prefHeight="29.0" prefWidth="93.0" style="-fx-background-color: blue;" text="Refresh" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Button>

                              <Button onAction="#GoToCreate" layoutX="636.0" layoutY="25.0" mnemonicParsing="false"
                                      prefHeight="29.0" prefWidth="93.0" style="-fx-background-color: blue;" text="Add Supplier" textFill="WHITE" AnchorPane.rightAnchor="31.333333333333258">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Button>
                           </children>
                        </AnchorPane>

                        <!-- 🔽 Cards Area -->
                        <FlowPane fx:id="cardsContainer" alignment="TOP_CENTER" hgap="10.0"
                                  maxWidth="1.7976931348623157E308" prefWidth="200.0"
                                  style="-fx-padding: 10;" vgap="10.0">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </FlowPane>

                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
